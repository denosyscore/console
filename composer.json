{
  "name": "denosyscore/console",
  "description": "Console kernel and command infrastructure",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.4",
    "denosyscore/contracts": "^0.2",
    "denosyscore/container": "^0.2",
    "denosyscore/database": "dev-codex/migration-pretend-read-only as 0.2.x-dev",
    "denosyscore/http": "^0.2",
    "denosyscore/queue": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Console\\": "src/Console/"
    }
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests/MigratePreviewCommandTest.php"
  },
  "config": {
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/denosyscore/database"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
