{
  "name": "denosyscore/console",
  "description": "Console kernel and command infrastructure",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "symfony/console": "^7.4",
    "denosyscore/contracts": "^0.2",
    "denosyscore/container": "^0.2",
    "denosyscore/database": "^0.2.3 || ^0.3 || ^0.4 || ^0.5",
    "denosyscore/http": "^0.2 || ^0.3 || ^0.4",
    "denosyscore/queue": "^0.3"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Console\\": "src/Console/"
    }
  },
  "scripts": {
    "test": "phpunit --bootstrap vendor/autoload.php tests"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "egulias/email-validator": "^4.0",
    "phpunit/phpunit": "^10.5",
    "symfony/mime": "^7.4 || ^8.0"
  }
}
