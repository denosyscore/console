<?php

declare(strict_types=1);

namespace App\Console\Commands;

use Denosys\Console\AsCommand;
use Denosys\Console\CommandDefinition;
use Denosys\Console\InputInterface;
use Denosys\Console\OutputInterface;

/**
 * {{ description }}
 */
#[AsCommand('{{ command_name }}', '{{ description }}')]
final readonly class {{ class }}
{
    // Constructor dependencies are resolved when the command runs.

    public static function definition(): CommandDefinition
    {
        return (new CommandDefinition())
            // ->addArgument('arg', CommandDefinition::ARGUMENT_REQUIRED, 'Description')
            // ->addOption('opt', 'o', CommandDefinition::OPTION_OPTIONAL, 'Description')
            ->setHelp(<<<HELP
{{ description }}

Examples:
  php core {{ command_name }}
HELP);
    }

    public function __invoke(InputInterface $input, OutputInterface $output): int
    {
        // Your command logic here

        $output->success('Done!');

        return 0;
    }
}
